# বাবল সর্ট
ফাংশন সাজাও(তালিকা) {
  ধরি n = দৈর্ঘ্য(তালিকা)
  ধরি i = ০
  যতক্ষণ i < n {
    ধরি j = ০
    যতক্ষণ j < n - i - ১ {
      যদি তালিকা[j] > তালিকা[j + ১] {
        ধরি অস্থায়ী = তালিকা[j]
        তালিকা[j] = তালিকা[j + ১]
        তালিকা[j + ১] = অস্থায়ী
      }
      j = j + ১
    }
    i = i + ১
  }
  ফেরত তালিকা
}

ছাপো সাজাও([৫, ২, ৯, ১, ৬])
